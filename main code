import cv2
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision
import pyttsx3
import threading
import time

# --- Voice & Setup ---
engine = pyttsx3.init()
engine.setProperty('rate', 150)

def speak(text):
    def run():
        engine.say(text)
        engine.runAndWait()
    threading.Thread(target=run, daemon=True).start()

detector = vision.HandLandmarker.create_from_options(vision.HandLandmarkerOptions(
    base_options=python.BaseOptions(model_asset_path='hand_landmarker.task'), num_hands=1))

CONNECTIONS = [(0,1), (1,2), (2,3), (3,4), (0,5), (5,6), (6,7), (7,8), (5,9), (9,10), (10,11), (11,12), (9,13), (13,14), (14,15), (15,16), (13,17), (0,17), (17,18), (18,19), (19,20)]

cap = cv2.VideoCapture(0)
last_speak_time = 0
last_gesture = None

while cap.isOpened():
    success, img = cap.read()
    if not success: break
    img = cv2.flip(img, 1)
    h, w, _ = img.shape
    rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    result = detector.detect(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb))
    
    if result.hand_landmarks:
        for lm in result.hand_landmarks:
            points = [(int(p.x * w), int(p.y * h)) for p in lm]
            
            # Skeleton draw
            for start, end in CONNECTIONS: cv2.line(img, points[start], points[end], (255, 255, 255), 2)
            for cx, cy in points: cv2.circle(img, (cx, cy), 6, (0, 255, 0), -1)
            
            # Logic function
            def is_up(t, j): return points[t][1] < points[j][1]
            idx, mid, rng, pky = is_up(8, 6), is_up(12, 10), is_up(16, 14), is_up(20, 18)
            dist_c = ((points[8][0]-points[4][0])**2 + (points[8][1]-points[4][1])**2)**0.5
            
            gesture = None
            # Naya mapping:
            if idx and mid and rng and pky: gesture = "Hi"
            elif not idx and not mid and not rng and pky and points[4][1] < points[2][1]: gesture = "My" # Telephone
            elif idx and not mid and not rng and not pky: gesture = "Name"
            elif idx and not mid and dist_c < 60: gesture = "Is"
            elif dist_c < 30: gesture = "Aditya"
            elif not idx and not mid and not rng and not pky and points[4][1] < points[8][1]: gesture = "Bye"

            if gesture and (gesture != last_gesture or time.time() - last_speak_time > 3):
                cv2.putText(img, gesture, (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 2, (0, 0, 255), 3)
                speak(gesture)
                last_gesture = gesture
                last_speak_time = time.time()

    cv2.imshow("Sign Language Skeleton", img)
    if cv2.waitKey(1) & 0xFF == ord('q'): break

cap.release()
cv2.destroyAllWindows()
