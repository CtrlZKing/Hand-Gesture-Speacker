import cv2
import pyttsx3
import threading
import time

# 1. To import MediaPipe 
import mediapipe as mp
mp_hands = mp.solutions.hands
mp_draw = mp.solutions.drawing_utils

# Setup
engine = pyttsx3.init()
def speak(text):
    def run():
        engine.say(text)
        engine.runAndWait()
    threading.Thread(target=run, daemon=True).start()

hands = mp_hands.Hands(max_num_hands=1, min_detection_confidence=0.7)
cap = cv2.VideoCapture(0)
last_speak_time = 0
last_gesture = None

while cap.isOpened():
    success, img = cap.read()
    if not success: break
    img = cv2.flip(img, 1)
    
    results = hands.process(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    
    if results.multi_hand_landmarks:
        for lms in results.multi_hand_landmarks:
            # SKELETON DRAWING (Dots + Lines)
            mp_draw.draw_landmarks(img, lms, mp_hands.HAND_CONNECTIONS)
            
            lm = lms.landmark
            # Logic: Simplified Finger Up/Down
            idx_up = lm[8].y < lm[6].y
            mid_up = lm[12].y < lm[10].y
            rng_up = lm[16].y < lm[14].y
            pky_up = lm[20].y < lm[18].y
            
            gesture = None
            if idx_up and mid_up and rng_up and pky_up: gesture = "Hi"
            elif not idx_up and not mid_up and not rng_up and pky_up and lm[4].y < lm[2].y: gesture = "My"
            elif idx_up and not mid_up and not rng_up and not pky_up: gesture = "Name"
            elif idx_up and abs(lm[8].x - lm[4].x) < 0.05: gesture = "Is"
            elif abs(lm[8].x - lm[4].x) < 0.03 and abs(lm[8].y - lm[4].y) < 0.03: gesture = "Aditya"
            elif lm[4].y < lm[8].y and not idx_up: gesture = "Bye"

            if gesture and (gesture != last_gesture or time.time() - last_speak_time > 3):
                cv2.putText(img, gesture, (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 2, (0, 255, 0), 3)
                speak(gesture)
                last_gesture = gesture
                last_speak_time = time.time()

    cv2.imshow("Working App", img)
    if cv2.waitKey(1) & 0xFF == ord('q'): break

cap.release()
cv2.destroyAllWindows()
